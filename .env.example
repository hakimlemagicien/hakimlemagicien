# Payments V1 — provider configuration (Commercial V1)
# Public client configuration (safe for Vite — no secrets)
VITE_PAYMENT_PROVIDER=paddle
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_ESSENTIAL_3=
VITE_PADDLE_PRICE_ESSENTIAL_6=
VITE_PADDLE_PRICE_PREMIUM_3=
VITE_PADDLE_PRICE_PREMIUM_6=

# Server-only (Supabase Edge Functions / Dashboard secrets — NEVER prefix with VITE_)
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_ENV=sandbox

# App environment: production | staging | development
# Staging builds MUST set VITE_APP_ENV=staging and must NOT use the Production project ref.
# VITE_APP_ENV=production

# Supabase (client — copy from the matching environment Dashboard → Settings → API)
# PRODUCTION ref: ufgrbpakuemamggwypdh
# STAGING ref: dxerwrdpcflpnjvsnrjq
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Edge function secrets (Supabase Dashboard → Edge Functions → Secrets)
# SITE_URL=https://hakimlemagicien.com
# ADMIN_NOTIFICATION_EMAIL=support@hakimlemagicien.com
# RESEND_API_KEY=re_...   # required — get from https://resend.com (verify domain hakimlemagicien.com)
# EMAIL_FROM=Hakim Coaching <support@hakimlemagicien.com>
# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_ANON_KEY are auto-injected in Supabase
